{
  "manifest_version": 3,
  "name": "Tether Website Blocker",
  "version": "1.0.0",
  "description": "Blocks websites during an active Tether desktop focus session.",
  "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "alarms", "storage"],
  "host_permissions": [
    "http://127.0.0.1:17894/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tether",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
